# ---------------------------------------------------------------
# Server-side only. NEVER prefix these with NEXT_PUBLIC_.
# Vercel: Project → Settings → Environment Variables
# ---------------------------------------------------------------

# GitHub content storage (fine-grained token: Contents = Read and write, only this repo)
GITHUB_TOKEN=
GITHUB_OWNER=KA71337
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PRODUCTS_PATH=data/products.json

# Optional — defaults shown
# GITHUB_SERVICES_PATH=data/services.json
# GITHUB_CATEGORIES_PATH=data/categories.json
# GITHUB_SETTINGS_PATH=data/settings.json
# GITHUB_UPLOADS_DIR=data/uploads

# Admin login: username is "admin", password is ADMIN_PASSWORD
ADMIN_PASSWORD=
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`)
SESSION_SECRET=

# Public site URL — used for canonical URLs, sitemap and Open Graph (not a secret)
NEXT_PUBLIC_SITE_URL=
